datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  googleId         String?           @unique
  email            String            @unique
  name             String
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  emails           Email[]
  slackIntegration SlackIntegration?
}

model Sender {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  smtpHost    String
  smtpPort    Int
  smtpUser    String
  smtpPass    String
  hourlyLimit Int      @default(100)
  createdAt   DateTime @default(now())
  emails      Email[]
}

model Email {
  id           String    @id @default(uuid())
  senderId     String
  sender       Sender    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  from         String
  to           String
  subject      String
  body         String    @db.Text
  status       String    @default("scheduled") // "scheduled" | "processing" | "sent" | "failed"
  scheduledAt  DateTime?
  sentAt       DateTime?
  failedReason String?
  retryCount   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([senderId])
  @@index([scheduledAt])
}

model SlackIntegration {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookUrl  String
  channelName String?
  accessToken String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
