# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database & Queue Connections
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
ELASTICSEARCH_NODE=http://localhost:9200

# Concurrency & Rate Limiting (Configurable via ENV)
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_SEC=2
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Session Secret
SESSION_SECRET="reachinbox_secret_session_production_grade_token_2026"

# Google OAuth (Passport.js)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Slack OAuth & Alerts
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:4000/api/slack/callback"
SLACK_WEBHOOK_URL=""
